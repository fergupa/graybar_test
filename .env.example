# Required: the agents run on the Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Recommended for deployment (Vercel etc.): Supabase persistence.
# Without these the app falls back to a local JSON file (fine for local dev,
# but state is ephemeral on serverless hosts).
# Project settings → Data API for the URL; → API keys for the service role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: Apple (iCloud) Calendar via CalDAV. When set, the agents read and
# write your real iCloud calendar instead of the built-in mock calendar.
# Generate the app-specific password at appleid.apple.com → Sign-In and
# Security → App-Specific Passwords.
# APPLE_CALDAV_USERNAME=you@icloud.com
# APPLE_CALDAV_APP_PASSWORD=abcd-efgh-ijkl-mnop
# Optional: which calendar to use, by its display name (default: your first calendar)
# APPLE_CALDAV_CALENDAR=Family

# Optional: override the model used by all agents (defaults to claude-opus-4-8)
# FAMILY_HQ_MODEL=claude-opus-4-8
